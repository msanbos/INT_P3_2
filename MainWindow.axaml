<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignWidth="800" d:DesignHeight="450"
        x:Class="INT_P3_2.MainWindow"
        Title="Inscripción del curso">
    <!--Distribución del Grid Principal: Cabecera - Fila 0 (Auto) + Formulario (Lo que sobre) + Pie(Auto)-->
    <Grid RowDefinitions="Auto,*,Auto">
        <!--Cabecera-->
        <Border Grid.Row="0" Background="#FF0C1E54" Padding="10"><!--Seleccionamos que este borde sera la primera fila(0)-->
            <StackPanel Spacing="4" >
                <TextBlock Text="Inscripción del curso" FontSize="14" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="IES El Majuelo - Formación complementaria" FontSize="10" Foreground="White"/>                
            </StackPanel>
        
        <!--Formulario-->
        </Border>
        <!--Grid.Row en la fila 1 para estirarse al ancho disponible en esa fila (*)-->
        <!--Será ScrollViewer por si el contenido excete el espacio disponible -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="LightGray">
            <StackPanel  Spacing="10">
                <!--Bloque Datos personales-->
                <Border Margin="10" Padding="10" BorderThickness="1"  VerticalAlignment="Top" Background="White">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Datos personales" FontSize="12"  FontWeight="Bold" Foreground="#FF0C1E54"/>
                        <!-- LOS CAMPOS DE ENTRADA CON GRID -->
                        <!--Campos de entrada-->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12" >
                            <!--Nombre-->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Watermark="Tu nombre" FontSize="12" />
                            <!--Apellidos-->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Apellidos:" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Watermark="Tu apellidos" FontSize="12"/>
                            <!--Fecha de nacimiento-->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fecha de nacimiento:" FontSize="12" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="2" Grid.Column="1" FontSize="12"/>
                            <!--Email-->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Correo electrónico" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Watermark="nombre@correo.es" FontSize="12"/>
                        </Grid>             
                    </StackPanel>
                </Border>

                <!--Bloque Curso-->
                <Border Margin="10" Padding="10" BorderThickness="1"  VerticalAlignment="Top" Background="White">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Curso" FontSize="12"  FontWeight="Bold" Foreground="#FF0C1E54"/>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12">
                            <!--Curso-->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Curso:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" FontSize="12" >
                                <ComboBoxItem Content="Desarrollo de interfaces con Avalonia" IsSelected="True"/>
                                <ComboBoxItem Content="Desarrollo de aplicaciones web"/>
                                <ComboBoxItem Content="Administración de sistemas e infraestructura"/>
                            </ComboBox>
                            <!--Modalidad-->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Modalidad:" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="20">
                                <RadioButton Content="Presencial" FontSize="12" IsChecked="True"/>
                                <RadioButton Content="Online" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>    
                </Border>
                
                <!--Bloque Preferencias-->
                <Border Margin="10" Padding="10" BorderThickness="1"  VerticalAlignment="Top" Background="White">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Preferencias" FontSize="12"  FontWeight="Bold" Foreground="#FF0C1E54"/>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Intereses: " FontSize="12" VerticalAlignment="Center"/>    
                            <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="12">
                                <CheckBox Grid.Row="0" Grid.Column="0" Content="Programación" FontSize="12" IsChecked="True"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="Diseño" FontSize="12" IsChecked="True"/>
                                <CheckBox Grid.Row="0" Grid.Column="2" Content="Bases de datos" FontSize="12"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="Redes" FontSize="12"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="Móviles" FontSize="12"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" Content="Videojuegos" FontSize="12"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nivel (1 a 5): " FontSize="12" VerticalAlignment="Center"/>    
                            <!--Incluimos el Slider y su "Subtitulo" en un StackPanel para encapsularlo mejor-->
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <!-- Con TickFrecuency indicamos de cuanto serán los intervalos, y con IsSnap...Enabled hacemos que sea fijo solo en esas fracciones-->
                                <Slider  Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="3"/>
                                <TextBlock Text="1 = principiante · 5 = avanzado" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Novedades: " FontSize="12" VerticalAlignment="Center"/>   
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" OffContent="NO quiero recibir novedades por correo" OnContent="Quiero recibir novedades por correo" FontSize="12" IsChecked="True"/> 
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        
    </Grid>          
</Window>
